{
  "entry": [
    "src/cli.ts!",
    "src/index.ts!",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "tests/**"
  ],
  "project": ["src/**/*.ts!", "src/**/*.tsx!"],
  "ignore": ["dist/**"],
  "ignoreDependencies": [
    "eslint",
    "ts-morph",
    "@typescript-eslint/parser",
    "@typescript-eslint/eslint-plugin",
    "jscpd"
  ]
}
